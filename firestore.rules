rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // products collection
    // Public: anyone can read (so the website can display products)
    // Write:  only requests that carry a valid admin JWT claim
    //         (set via Firebase Admin SDK custom tokens in the login flow)
    // ──────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // ──────────────────────────────────────────────────────────────────────
    // campaigns collection – same access pattern
    // ──────────────────────────────────────────────────────────────────────
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
