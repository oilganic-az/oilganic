{
  "name": "oilganic",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "npm run content:build && npm run icons:generate && npm run icons:validate && npm run sitemap:generate && tsc && vite build",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:validate": "node scripts/validate-icons.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "content:build": "npm run catalog:build && npm run campaigns:build",
    "catalog:build": "node scripts/build-admin-catalog.mjs",
    "campaigns:build": "node scripts/build-admin-campaigns.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.2",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
